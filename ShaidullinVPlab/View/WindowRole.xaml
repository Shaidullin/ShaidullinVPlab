<Window x:Class="ShaidullinVPlab.View.WindowRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShaidullinVPlab.View"
        mc:Ignorable="d"
        Title="WindowRole" Height="450" Width="800">
    <StackPanel Background="#FFD8D8D8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Добавить" Height="25" Margin="10,10,5,10" Width="100" Command="{Binding AddRole}"/>
            <Button Grid.Column="1" Content="Редактировать" Height="25" Margin="10,10,5,10" Width="100" Command="{Binding EditRole}"/>
            <Button Grid.Column="2" Content="Удалить" Height="25" Margin="10,10,5,10" Command="{Binding DeleteRole}"/>
        </Grid>
        <Label Margin="5" HorizontalAlignment="Center">Список должностей сотрудников</Label>
        <ListView ItemsSource="{Binding ListRole}" SelectedItem="{Binding SelectedRole}" Background="#FFD3CDCD">
            <ListView.View >
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Код" Width="50" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Наименование должности" DisplayMemberBinding="{Binding NameRole}"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Window>
