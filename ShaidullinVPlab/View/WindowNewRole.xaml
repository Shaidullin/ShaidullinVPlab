<Window x:Class="ShaidullinVPlab.View.WindowNewRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShaidullinVPlab.View"
        mc:Ignorable="d"
        Title="WindowNewRole" Height="250" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Label Margin="5" VerticalAlignment="Center">Код:</Label>
            <TextBox Margin="5" Width="100" Height="30" VerticalContentAlignment="Center" Text="{Binding Id}" IsReadOnly="True"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Label Margin="5" VerticalAlignment="Center">Должность:</Label>
            <TextBox Margin="5" Width="100" Height="30" VerticalContentAlignment="Center" Text="{Binding NameRole, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Width="100" Height="30" Margin="5" Content="Сохранить" Command="{Binding SaveCommand}"></Button>
            <Button Width="100" Height="30" Margin="5" Content="Отменить" Command="{Binding CancelCommand}"></Button>
        </StackPanel>
    </Grid>
</Window>
